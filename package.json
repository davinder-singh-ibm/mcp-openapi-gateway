{
  "name": "mcp-openapi-gateway",
  "version": "1.0.0",
  "description": "Enterprise-grade MCP OpenAPI Gateway - Dynamically converts OpenAPI specs into MCP tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:validate": "node scripts/validate-env.js && node dist/index.js",
    "validate": "node scripts/validate-env.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "mcp-inspector":"npx @modelcontextprotocol/inspector@latest"
  },
  "keywords": [
    "mcp",
    "openapi",
    "swagger",
    "gateway",
    "tools",
    "ai-agent"
  ],
  "author": "Davinder Singh",
  "email": "davinder.singh@ibm.com",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.14.0",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
