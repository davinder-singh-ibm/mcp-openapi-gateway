# MCP OpenAPI Gateway Configuration

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Comma-separated list of OpenAPI specification URLs
# Example: https://petstore.swagger.io/v2/swagger.json,https://api.example.com/openapi.json
SWAGGER_URLS=https://petstore.swagger.io/v2/swagger.json

# Server port
PORT=4000

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Auto-refresh OpenAPI specs (in seconds)
# Uncomment to enable periodic refresh
# SWAGGER_REFRESH_SECONDS=3600

# Timeout for fetching OpenAPI specs (milliseconds)
SWAGGER_TIMEOUT_MS=30000

# Allow invalid TLS certificates (for development only)
ALLOW_INSECURE_TLS=false

# Prefix for all tool names
# Example: If set to "myapp_", tools will be named "myapp_service_get_endpoint"
TOOL_NAME_PREFIX=

# Service name mode: host | title | custom
# - host: Use hostname from spec URL (e.g., "api_example_com")
# - title: Use spec info.title (e.g., "petstore")
# - custom: Use DEFAULT_SERVICE_NAME
SERVICE_NAME_MODE=title

# Default service name (used when SERVICE_NAME_MODE=custom or as fallback)
DEFAULT_SERVICE_NAME=api

# Maximum number of tools to generate (optional)
# Uncomment to limit total tools across all specs
# MAX_TOOLS=100

# ============================================================================
# AUTHENTICATION - GLOBAL (applies to all specs)
# ============================================================================

# Authentication type: none | apiKey | bearer | oauth2_client_credentials
AUTH_TYPE=none

# --- API Key Authentication ---
# Uncomment and configure if AUTH_TYPE=apiKey
# API_KEY=your-api-key-here
# API_KEY_HEADER=x-api-key

# --- Bearer Token Authentication ---
# Uncomment and configure if AUTH_TYPE=bearer
# BEARER_TOKEN=your-bearer-token-here

# --- OAuth2 Client Credentials ---
# Uncomment and configure if AUTH_TYPE=oauth2_client_credentials
# OAUTH2_TOKEN_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/oauth2/v2.0/token
# OAUTH2_CLIENT_ID=your-client-id
# OAUTH2_CLIENT_SECRET=your-client-secret
# OAUTH2_SCOPE=https://api.example.com/.default
# OAUTH2_RESOURCE=https://api.example.com  # For Microsoft Entra ID

# ============================================================================
# PER-SPEC CONFIGURATION (overrides global settings)
# ============================================================================

# Use indexed variables for spec-specific configuration
# Index starts at 0 for the first URL in SWAGGER_URLS

# Example: Configure auth for first spec (index 0)
# SWAGGER_0_AUTH_TYPE=apiKey
# SWAGGER_0_API_KEY=key-for-first-api
# SWAGGER_0_API_KEY_HEADER=x-api-key

# Example: Configure auth for second spec (index 1)
# SWAGGER_1_AUTH_TYPE=bearer
# SWAGGER_1_BEARER_TOKEN=token-for-second-api

# Example: Override base URL for first spec
# SWAGGER_0_BASE_URL=https://custom-base-url.example.com

# Example: OAuth2 for third spec (index 2)
# SWAGGER_2_AUTH_TYPE=oauth2_client_credentials
# SWAGGER_2_OAUTH2_TOKEN_URL=https://login.microsoftonline.com/tenant/oauth2/v2.0/token
# SWAGGER_2_OAUTH2_CLIENT_ID=client-id
# SWAGGER_2_OAUTH2_CLIENT_SECRET=client-secret
# SWAGGER_2_OAUTH2_SCOPE=api://app-id/.default
# SWAGGER_2_OAUTH2_RESOURCE=api://app-id

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Example 1: Single public API with no auth
# SWAGGER_URLS=https://petstore.swagger.io/v2/swagger.json
# AUTH_TYPE=none

# Example 2: Multiple APIs with different auth
# SWAGGER_URLS=https://api1.example.com/swagger.json,https://api2.example.com/openapi.json
# SWAGGER_0_AUTH_TYPE=apiKey
# SWAGGER_0_API_KEY=key-for-api1
# SWAGGER_1_AUTH_TYPE=bearer
# SWAGGER_1_BEARER_TOKEN=token-for-api2

# Example 3: Microsoft Entra ID (Azure AD) protected API
# SWAGGER_URLS=https://api.example.com/swagger.json
# AUTH_TYPE=oauth2_client_credentials
# OAUTH2_TOKEN_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/oauth2/v2.0/token
# OAUTH2_CLIENT_ID=YOUR-CLIENT-ID
# OAUTH2_CLIENT_SECRET=YOUR-CLIENT-SECRET
# OAUTH2_SCOPE=api://YOUR-APP-ID/.default
# OAUTH2_RESOURCE=api://YOUR-APP-ID